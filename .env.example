# AidDesk Configuration
# Copy this file to .env and adjust values

# Signaling server URL (WebSocket)
# Default (when unset): wss://aiddesk-signaling.mayor1012003.workers.dev (live Cloudflare Worker)
# Uncomment to use a different server, e.g. the local Node server in ./signaling-server:
# SIGNALING_SERVER_URL=ws://localhost:9090

# ICE servers: the app fetches STUN + short-lived Cloudflare TURN credentials from
# the signaling server's /ice-servers endpoint (TURN is configured as Worker secrets,
# never here). The values below are only the FALLBACK used when that fetch fails.
# Optional extra static TURN servers can still be added via TURN_SERVERS.
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVERS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Testing: set to 1 to force all traffic through TURN (iceTransportPolicy 'relay').
# Use it to confirm the TURN relay works; leave unset for normal use.
# AIDDESK_FORCE_RELAY=1

# Auto-disconnect timeout in minutes (0 = disabled)
INACTIVITY_TIMEOUT=10

# Session recording default directory (empty = user's Videos folder)
RECORDING_DIR=

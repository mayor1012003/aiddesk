# AidDesk Configuration
# Copy this file to .env and adjust values

# Signaling server URL (WebSocket)
# Point this to your self-hosted signaling server
SIGNALING_SERVER_URL=ws://localhost:9090

# STUN/TURN servers for NAT traversal (comma-separated)
# Default uses Google's free STUN server; add TURN for production
STUN_SERVERS=stun:stun.l.google.com:19302
TURN_SERVERS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Auto-disconnect timeout in minutes (0 = disabled)
INACTIVITY_TIMEOUT=10

# Session recording default directory (empty = user's Videos folder)
RECORDING_DIR=

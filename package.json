{
  "name": "aiddesk",
  "version": "1.0.0",
  "description": "AidDesk - Cross-platform remote desktop for IT troubleshooting",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"webpack --config webpack.renderer.config.js --watch\" \"wait-on dist/renderer/index.html && electron .\"",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:win": "npm run build:renderer && electron-builder --win",
    "build:mac": "npm run build:renderer && electron-builder --mac",
    "build:linux": "npm run build:renderer && electron-builder --linux",
    "rebuild": "electron-rebuild -f -w robotjs better-sqlite3",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "AidDesk Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "css-loader": "^6.10.0",
    "electron": "^28.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "wait-on": "^7.2.0",
    "webpack": "^5.90.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "argon2": "^0.31.2",
    "better-sqlite3": "^9.4.3",
    "electron-store": "^8.1.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "robotjs": "^0.6.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  }
}
